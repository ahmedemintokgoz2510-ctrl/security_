<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only needed so the in-app launcher list can see installed apps (Android 11+) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- VPN Service permission - required for BIND_VPN_SERVICE -->
    <uses-permission android:name="android.permission.ACCESS_VPN_SERVICE" />
    <!-- Internet permission for proxy fetching and VPN establishment -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network state for monitoring -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional: for direct VPN control without system UI -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.SecretVault"
        android:supportsRtl="true"
        android:name=".SecretVaultApplication">

        <!-- Not itself a launcher entry point any more - one of the aliases
             below (exactly one enabled at a time) is what shows on the home
             screen / app drawer. Switching the enabled alias at runtime is
             what changes the visible icon + name. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SecretVault" />

        <!-- Disguise 1 (default): plain gray "system sync" icon -->
        <activity-alias
            android:name=".AliasDefault"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Disguise 2: looks like a notes app -->
        <activity-alias
            android:name=".AliasNotes"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_notes"
            android:roundIcon="@mipmap/ic_disguise_notes"
            android:label="@string/disguise_label_notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Disguise 3: looks like a calculator app -->
        <activity-alias
            android:name=".AliasCalculator"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_calculator"
            android:roundIcon="@mipmap/ic_disguise_calculator"
            android:label="@string/disguise_label_calculator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Disguise 4: looks like a gallery app -->
        <activity-alias
            android:name=".AliasGallery"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_disguise_gallery"
            android:roundIcon="@mipmap/ic_disguise_gallery"
            android:label="@string/disguise_label_gallery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Lets the system Camera app write a photo straight into this
             app's own private storage (not the public/system gallery). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Auto-Configuring VPN Service -->
        <service
            android:name=".network.VpnAutoService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
        </service>

        <!-- Zero-Leak Sandbox Isolation Service -->
        <service
            android:name=".sandbox.IsolationService"
            android:exported="false"
            android:process=":sandbox">
        </service>

    </application>

</manifest>